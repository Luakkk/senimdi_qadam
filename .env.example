# ═══════════════════════════════════════════════════════════════════
# SenimdiQAdam — ПРИМЕР переменных окружения
# ═══════════════════════════════════════════════════════════════════
# Скопируй этот файл в infra/.env и заполни реальными значениями:
#   cp .env.example infra/.env
# Файл infra/.env автоматически подхватывается docker compose.
# ⚠️  НИКОГДА НЕ КОММИТЬ infra/.env В GIT (реальные секреты!)
# ═══════════════════════════════════════════════════════════════════

# ─── Базы данных ────────────────────────────────────────────────────
CORE_DB_USER=core_user
CORE_DB_PASSWORD=CHANGE_ME_strong_password
CORE_DB_NAME=core_db

TAXI_DB_USER=taxi_user
TAXI_DB_PASSWORD=CHANGE_ME_strong_password
TAXI_DB_NAME=taxi_db

AI_DB_USER=ai_user
AI_DB_PASSWORD=CHANGE_ME_strong_password
AI_DB_NAME=ai_db

# ─── Redis ───────────────────────────────────────────────────────────
# Генерируй: openssl rand -hex 16
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# ─── JWT (генерируй: openssl rand -hex 32) ──────────────────────────
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Google OAuth ────────────────────────────────────────────────────
# Получить: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# ─── Email (Resend) ──────────────────────────────────────────────────
# Получить: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@your-domain.kz

# ─── Frontend ────────────────────────────────────────────────────────
# URL фронтенда — используется для редиректа после Google OAuth
FRONTEND_URL=http://localhost:5173

# ─── Admin Panel ─────────────────────────────────────────────────────
# Генерируй: openssl rand -hex 32
ADMIN_COOKIE_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
ADMIN_KEY=CHANGE_ME_generate_with_openssl_rand_hex_16

# ─── Порты ───────────────────────────────────────────────────────────
CORE_PORT=3001
TAXI_PORT=3002
GATEWAY_PORT=3000
AI_PORT=8000

# ─── Azure OpenAI ────────────────────────────────────────────────────
# Получить: https://portal.azure.com → Azure OpenAI → Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2025-01-01-preview
# Название деплоймента для эмбеддингов (text-embedding-3-small)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ─── MinIO Object Storage ─────────────────────────────────────────────────────
# Консоль MinIO: http://localhost:9001 (логин/пароль = MINIO_ROOT_USER/PASSWORD)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_minio_password
# Публичный URL для доступа к файлам (в Docker — http://localhost:9000)
MINIO_PUBLIC_URL=http://localhost:9000

# ─── Sentry (опционально) ─────────────────────────────────────────────────────
# Получить DSN: https://sentry.io → Settings → Projects → Client Keys
# Оставьте пустым — Sentry не будет инициализирован
SENTRY_DSN=
NODE_ENV=production

# ─── Firebase / FCM Push Notifications (опционально) ─────────────────────────
# Получить: https://console.firebase.google.com → Project Settings → Service Accounts
# → Generate new private key → скачать JSON, скопировать значения
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# В private key замените переносы строк на \n (одна строка)
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
