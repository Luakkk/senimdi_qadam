# ── Node modules (устанавливаются внутри контейнера через npm ci) ─────────────
node_modules/

# ── Prisma generated clients ──────────────────────────────────────────────────
# macOS-бинарники (.dylib.node) и дубликаты ("* 2.*") НЕ должны попадать в Docker.
# Клиенты генерируются заново через `npm run prisma:generate` внутри builder-образа
# (Linux/Alpine) и дают правильный бинарник для linux-musl.
generated/

# ── Build artifacts ───────────────────────────────────────────────────────────
dist/
.adminjs/

# ── Secrets и логи ────────────────────────────────────────────────────────────
.env
*.log

# ── OS/IDE ────────────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
