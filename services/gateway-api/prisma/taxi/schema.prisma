// gateway-api — копия taxi_db схемы для AdminJS
// ⚠️  СИНХРОНИЗИРОВАТЬ при изменении services/taxi-svc/prisma/schema.prisma
// Prisma генерирует клиент в generated/taxi

generator client {
  provider      = "prisma-client-js"
  output        = "../../generated/taxi"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("TAXI_DB_URL")
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum VehicleType {
  SEDAN
  MINIVAN
  WHEELCHAIR_VAN
  OTHER
}

enum DisabilityType {
  WHEELCHAIR
  VISUAL
  HEARING
  MOBILITY
  OTHER
}

enum MessageSender {
  USER
  MANAGER
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum PaymentMethod {
  CASH
  KASPI
  CARD
}

model TaxiManager {
  id        String   @id @default(uuid())
  userId    String   @unique
  firstName String
  lastName  String
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  bookings Booking[]
  messages BookingMessage[]
}

model Driver {
  id           String       @id @default(uuid())
  userId       String?      @unique
  firstName    String
  lastName     String
  phone        String       @unique
  whatsapp     String?
  vehicleType  VehicleType  @default(WHEELCHAIR_VAN)
  vehicleModel String?
  licensePlate String       @unique
  status       DriverStatus @default(ACTIVE)
  fcmToken     String?
  ratingAvg    Float        @default(0)
  ratingCount  Int          @default(0)
  totalTrips   Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  bookings Booking[]
  reviews  DriverReview[]
}

model Booking {
  id              String         @id @default(uuid())
  userId          String
  managerId       String?
  manager         TaxiManager?   @relation(fields: [managerId], references: [id])
  driverId        String?
  driver          Driver?        @relation(fields: [driverId], references: [id])
  fromAddress     String
  toAddress       String
  fromLat         Float?
  fromLon         Float?
  toLat           Float?
  toLon           Float?
  scheduledAt     DateTime
  disabilityType  DisabilityType
  note            String?
  status          BookingStatus  @default(PENDING)
  cancelReason    String?
  estimatedPrice  Float?
  paymentStatus   PaymentStatus  @default(UNPAID)
  paymentMethod   PaymentMethod?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  messages     BookingMessage[]
  review       DriverReview?
  transactions PaymentTransaction[]
}

model BookingMessage {
  id         String        @id @default(uuid())
  bookingId  String
  booking    Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  managerId  String?
  manager    TaxiManager?  @relation(fields: [managerId], references: [id])
  senderId   String
  senderType MessageSender
  text       String
  isRead     Boolean       @default(false)
  createdAt  DateTime      @default(now())
}

model DriverReview {
  id        String   @id @default(uuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id])
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model ManagerInvite {
  id        String    @id @default(uuid())
  code      String    @unique
  usedBy    String?
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

model RecurringBooking {
  id              String         @id @default(uuid())
  userId          String
  fromAddress     String
  toAddress       String
  fromLat         Float?
  fromLon         Float?
  toLat           Float?
  toLon           Float?
  disabilityType  DisabilityType
  note            String?
  cronExpression  String
  isActive        Boolean        @default(true)
  lastTriggeredAt DateTime?
  nextRunAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model PaymentTransaction {
  id          String        @id @default(uuid())
  bookingId   String
  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId      String
  amount      Float
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  externalId  String?
  externalUrl String?
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}
