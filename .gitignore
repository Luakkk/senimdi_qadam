prisma/dev.db-journal

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/

# ── OS / IDE ─────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
Thumbs.db

